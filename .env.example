# =====================================================================
# Insurance Assistant — backend environment
# Only secrets and deployment-specific values live here. Algorithmic
# hyperparameters (chunk size, top-k, BM25/semantic weights) are code
# constants under app/{ingestion,rag}/constants.py — change via PR.
# Business limits (max files / size / pages) have safe defaults in
# app/core/config.py and can be overridden here only if you really
# need to deviate from the product spec.
# =====================================================================

# --- Required ---
OPENAI_API_KEY=sk-your_openai_key_here

# --- Models (override only when swapping snapshots) ---
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# --- Server ---
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=info

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Storage ---
CHROMA_PERSIST_DIR=data/chroma

# --- Session ---
SESSION_COOKIE_NAME=iasid
SESSION_TTL_SECONDS=86400

# --- OCR (Tesseract language packs installed on the host) ---
OCR_LANGUAGES=eng+vie
